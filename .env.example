# Copia este archivo a `.env` y ajusta valores para tu entorno local

# Cadena de conexión SQLAlchemy para PostgreSQL
DATABASE_URL=postgresql+psycopg://user:sintetica@localhost:5432/girardot

# Orígenes permitidos para CORS (separados por coma si hay varios)
CORS_ORIGINS=http://localhost:5173

# Secreto para firmar JWT (cambia en producción)
SECRET_KEY=please_change_me

# Minutos de expiración para el access token
ACCESS_TOKEN_EXPIRE_MINUTES=60
